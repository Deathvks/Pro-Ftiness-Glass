{
    # Zeabur asigna el puerto a través de esta variable de entorno.
    http_port {$PORT}
}

# Configura el servidor para que escuche en el puerto asignado.
:{$PORT} {
    # Define la carpeta raíz donde están los archivos de la web.
    root * /usr/share/caddy

    # Desactivar caché estricto para archivos que controlan la versión y el service worker
    @noCache {
        path /sw.js /index.html /version.json /manifest.webmanifest /robots.txt /sitemap.xml
    }
    header @noCache {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    # Si se solicita un asset en /assets/* que NO existe físicamente en disco, devolver 404 inmediato.
    # Evita que chunks obsoletos devuelvan index.html con código 200 y se guarden en caché como JS roto.
    @missingAsset {
        path /assets/*
        not file
    }
    respond @missingAsset 404

    # Caché agresivo inmutable SOLO para los assets que realmente existen en disco
    @staticAssets {
        path /assets/*
        file
    }
    header @staticAssets {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Activa el servidor de archivos estáticos.
    file_server

    # Redirige todas las rutas de navegación a index.html para que funcione el enrutador de React.
    try_files {path} /index.html
}