{
    # Zeabur asigna el puerto a través de esta variable de entorno.
    http_port {$PORT}
}

# Configura el servidor para que escuche en el puerto asignado.
:{$PORT} {
    # Define la carpeta raíz donde están los archivos de la web.
    root * /usr/share/caddy

    # Compresión Zstandard y Gzip obligatoria para reducir JS/CSS un 75-85%
    encode zstd gzip

    # Desactivar caché estricto para /, rutas SPA, HTML, version.json y service worker
    @noCache {
        not path /assets/* /icons/* *.png *.webp *.ico *.svg *.jpg *.jpeg *.woff *.woff2
    }
    header @noCache {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    # Proxy inverso dinámico hacia el servidor canónico de producción (profitnessglass.es)
    handle /sitemap.xml {
        reverse_proxy https://profitnessglass.es {
            header_up Host profitnessglass.es
        }
    }

    handle /rss.xml {
        reverse_proxy https://profitnessglass.es {
            header_up Host profitnessglass.es
        }
    }

    handle /feed.xml {
        reverse_proxy https://profitnessglass.es {
            header_up Host profitnessglass.es
        }
    }

    # Proxy inverso transparente para la API (mantiene vivas apps móviles y clientes que apunten a la URL anterior)
    handle /api/* {
        reverse_proxy https://profitnessglass.es {
            header_up Host profitnessglass.es
        }
    }

    handle /uploads/* {
        reverse_proxy https://profitnessglass.es {
            header_up Host profitnessglass.es
        }
    }

    handle /images/* {
        reverse_proxy https://profitnessglass.es {
            header_up Host profitnessglass.es
        }
    }

    # Si se solicita un asset en /assets/* que NO existe físicamente en disco, devolver 404 inmediato.
    # Evita que chunks obsoletos devuelvan index.html con código 200 y se guarden en caché como JS roto.
    @missingAsset {
        path /assets/*
        not file
    }
    respond @missingAsset 404

    # Caché agresivo inmutable SOLO para los assets con hash que realmente existen en disco
    @staticAssets {
        path /assets/*
        file
    }
    header @staticAssets {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Servidor de archivos estáticos y fallback SPA
    handle {
        file_server
        try_files {path} {path}/index.html {path}index.html /index.html
    }
}
