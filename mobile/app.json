{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "7.16.27",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Permite a ProFitnessGlass usar tu ubicación para encontrar gimnasios cercanos y registrar tus rutas de cardio.",
        "NSCameraUsageDescription": "Permite a ProFitnessGlass escanear códigos de barras de alimentos para registrar tus comidas rápidamente."
      }
    },
    "android": {
      "versionCode": 377,
      "package": "com.profitnessglass.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pro-fitness-glass.zeabur.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-asset",
      "expo-sharing",
      "expo-video",
      "expo-font",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a ProFitnessGlass acceder a tu ubicación para encontrar los gimnasios más cercanos a ti."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a ProFitnessGlass escanear códigos de barras de alimentos para registrar tus comidas rápidamente."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
