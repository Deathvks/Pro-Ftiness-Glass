{
  "expo": {
    "name": "Pro Fitness Glass",
    "slug": "mobile",
    "version": "8.0.1-beta.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "profitnessglass",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.profitnessglass.app",
      "icon": "./assets/expo.icon",
      "associatedDomains": [
        "applinks:profitnessglass.es",
        "applinks:www.profitnessglass.es",
        "applinks:pro-fitness-glass.zeabur.app"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Permite a ProFitnessGlass usar tu ubicación para encontrar gimnasios cercanos y registrar tus rutas de cardio.",
        "NSCameraUsageDescription": "Permite a ProFitnessGlass escanear códigos de barras de alimentos para registrar tus comidas rápidamente."
      }
    },
    "android": {
      "versionCode": 812,
      "package": "com.profitnessglass.app",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#178a44",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "profitnessglass.es"
            },
            {
              "scheme": "https",
              "host": "www.profitnessglass.es"
            },
            {
              "scheme": "https",
              "host": "pro-fitness-glass.zeabur.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#178a44",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-asset",
      "expo-sharing",
      "expo-secure-store",
      "expo-video",
      "expo-font",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a ProFitnessGlass acceder a tu ubicación para encontrar los gimnasios más cercanos a ti."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a ProFitnessGlass escanear códigos de barras de alimentos para registrar tus comidas rápidamente.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a ProFitnessGlass acceder a tus fotos para subir imágenes de perfil y publicaciones.",
          "cameraPermission": "Permite a ProFitnessGlass usar tu cámara para tomar fotos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22c55e"
        }
      ],
      "./plugins/withNativeRestTimer"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "713ad1f9-1ca6-4796-ae68-0ec57e6ee992"
      }
    }
  }
}
