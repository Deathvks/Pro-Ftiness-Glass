{
    # Zeabur asigna el puerto a través de esta variable de entorno.
    http_port {$PORT}
}

# Configura el servidor para que escuche en el puerto asignado.
:{$PORT} {
    # Define la carpeta raíz donde están los archivos de la web.
    root * /usr/share/caddy

    # Desactivar caché estricto para archivos que controlan la versión y el service worker
    @noCache {
        path /sw.js /index.html /version.json /manifest.webmanifest /robots.txt /sitemap.xml
    }
    header @noCache {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    # Caché agresivo inmutable para los assets con hash generado por Vite
    @staticAssets {
        path /assets/*
    }
    header @staticAssets {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Activa el servidor de archivos estáticos.
    file_server

    # Redirige todas las rutas a index.html para que funcione el enrutador de React.
    try_files {path} /index.html
}
